{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://nabobery.com/kotlin-sdkgen/extensions/x-sdkgen-pagination.schema.json",
    "type": "object",
    "properties": {
        "style": { "enum": ["cursor", "headerNextUrl", "offsetLimit"] },
        "requestCursor": { "type": "string", "minLength": 1 },
        "requestOffset": { "type": "string", "minLength": 1 },
        "requestLimit": { "type": "string", "minLength": 1 },
        "responseItems": { "type": "string", "pattern": "^/(?:[^~]|~[01])*$" },
        "responseNextCursor": {
            "type": "string",
            "pattern": "^/(?:[^~]|~[01])*$"
        },
        "responseTotal": {
            "type": "string",
            "pattern": "^/(?:[^~]|~[01])*$"
        }
    },
    "required": ["style", "responseItems"],
    "allOf": [
        {
            "if": {
                "properties": { "style": { "const": "cursor" } },
                "required": ["style"]
            },
            "then": {
                "additionalProperties": false,
                "properties": {
                    "style": {},
                    "requestCursor": {},
                    "requestLimit": {},
                    "responseItems": {},
                    "responseNextCursor": {}
                },
                "required": [
                    "style",
                    "requestCursor",
                    "responseItems",
                    "responseNextCursor"
                ]
            }
        },
        {
            "if": {
                "properties": { "style": { "const": "headerNextUrl" } },
                "required": ["style"]
            },
            "then": {
                "additionalProperties": false,
                "properties": {
                    "style": {},
                    "responseItems": {}
                },
                "required": ["style", "responseItems"]
            }
        },
        {
            "if": {
                "properties": { "style": { "const": "offsetLimit" } },
                "required": ["style"]
            },
            "then": {
                "additionalProperties": false,
                "properties": {
                    "style": {},
                    "requestOffset": {},
                    "requestLimit": {},
                    "responseItems": {},
                    "responseTotal": {}
                },
                "required": [
                    "style",
                    "requestOffset",
                    "requestLimit",
                    "responseItems"
                ]
            }
        }
    ]
}
